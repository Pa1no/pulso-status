{
  "name": "pulso-status",
  "version": "1.0.0",
  "description": "Monitor de disponibilidade com página de status pública utilizando Node.js, TypeScript e PostgreSQL.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc -b",
    "dev:worker": "tsx --env-file:.env apps/worker/src/index.ts",
    "dev:api": "tsx --env-file:.env apps/api/src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pa1no/pulso-status.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/Pa1no/pulso-status/issues"
  },
  "homepage": "https://github.com/Pa1no/pulso-status#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
